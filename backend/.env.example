# Baza
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slova?schema=public"
# Tajni ključ za tokene sesije — OBAVEZNO promeniti u produkciji (dug, nasumičan)
JWT_SECRET="promeni-me"
JWT_EXPIRES_IN="30d"
PORT=3000
# Vremenska zona za dnevnu nagradu, mesečne i godišnje rang-liste
GAME_TIMEZONE="Europe/Belgrade"
# Prvi administrator (kreira se pri pokretanju ako ne postoji)
ADMIN_USERNAME="admin25"
ADMIN_PASSWORD="promeni-me-123"
# Prijava preko Google / Apple (client ID-jevi aplikacije, razdvojeni zarezom)
GOOGLE_CLIENT_IDS=""
APPLE_CLIENT_IDS=""
# Slanje e-maila za zaboravljenu lozinku (npr. smtps://user:pass@smtp.example.com)
SMTP_URL=""
MAIL_FROM="noreply@25slova.app"
